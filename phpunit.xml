<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:2F4N2YgCqWKltvC6xz4vjKp5WfXna65iGMKYHFgI/qc="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="STIVE_WHATSAPP_NUMBER" value="237600000000"/>

        <!--
          Base de données des tests

          Seul le NOM de la base est forcé ici : il garantit que les tests
          n'effacent jamais les données de développement (migrate:fresh).

          L'hôte, le port et surtout l'utilisateur / mot de passe sont repris
          du fichier .env de la machine (ou de .env.testing s'il existe) :
          chaque poste garde ainsi ses propres identifiants MySQL.

          La base doit porter un nom terminé par « _test » : c'est vérifié
          avant toute migration par Tests\TestCase::setUpTraits().
        -->
        <env name="DB_DATABASE" value="stive_clothing_test"/>
    </php>
</phpunit>
