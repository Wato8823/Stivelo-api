# =============================================================================
# Production — modèle à copier pour Render (ou à renseigner dans le dashboard).
# NE PAS committer de vraie valeur : copier vers .env.production (ignoré par git)
# ou coller ces clés dans Render → Environment.
# =============================================================================
APP_NAME="Stive Clothing API"
APP_ENV=production
APP_KEY=                          # générer : php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://stive-clothing-api.onrender.com
APP_TIMEZONE=UTC

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Journaux sur stderr : Render les capture nativement.
LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Base de données (Render Postgres — interne, sans SSL requis) -----------
DB_CONNECTION=pgsql
# Render injecte l'URL de connexion interne via render.yaml (DB_URL).
# Sans blueprint, renseigner les identifiants affichés dans Render → Database :
DB_URL=                           # postgresql://user:pass@host/db (chaîne interne)
# DB_HOST= / DB_PORT= / DB_DATABASE= / DB_USERNAME= / DB_PASSWORD=

# --- Sessions / cache / queues ----------------------------------------------
# Aucun worker disponible en offre gratuite : la file reste en base, rien
# n'est mis en file dans l'application — les e-mails passent par le canal log.
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

BROADCAST_CONNECTION=log

# --- CORS (frontend Cloudflare Pages) ---------------------------------------
CORS_ALLOWED_ORIGINS=https://stive-clothing.pages.dev
CORS_SUPPORTS_CREDENTIALS=false

# --- Sanctum ----------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=stive-clothing.pages.dev
SANCTUM_TOKEN_PREFIX=stv_
SANCTUM_EXPIRATION=480

# --- Boutique Stive Clothing ------------------------------------------------
# Numéro WhatsApp professionnel au format international, sans "+" ni espaces.
STIVE_WHATSAPP_NUMBER=237600000000
STIVE_WHATSAPP_DEFAULT_MESSAGE="Bonjour Stive Clothing, je souhaite des informations sur une pièce."
STIVE_CURRENCY=XAF
STIVE_ORDER_PREFIX=STV
STIVE_ORDERS_PER_MINUTE=5
STIVE_LOGIN_ATTEMPTS_PER_MINUTE=5

# --- Médias : Cloudflare R2 (compatible S3, 10 Go gratuits) ------------------
PRODUCT_MEDIA_DISK=s3
PRODUCT_IMAGE_MAX_KB=4096
AWS_ACCESS_KEY_ID=               # clé R2 (dashboard Cloudflare → R2 → API tokens)
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=stive-media
# URL publique du bucket (r2.dev ou domaine personnalisé) — utilisée pour les <img>.
AWS_URL=https://pub-xxxx.r2.dev
AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@stiveclothing.example"
MAIL_FROM_NAME="${APP_NAME}"
