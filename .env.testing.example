# ---------------------------------------------------------------------------
# Identifiants utilisés uniquement par « php artisan test ».
#
#   cp .env.testing.example .env.testing
#
# Ce fichier est prioritaire sur .env lorsque APP_ENV=testing. Il permet
# d'utiliser un utilisateur MySQL dédié aux tests sans toucher à la
# configuration de développement.
#
# Le nom de la base, lui, reste imposé par phpunit.xml (stive_clothing_test) :
# il doit se terminer par « _test » pour que les tests puissent la recréer.
# ---------------------------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stive_clothing_test
DB_USERNAME=stive
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Sous MAMP/XAMPP, préférer le socket au couple hôte/port :
# DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock
