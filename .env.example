APP_NAME="Stive Clothing API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données (PostgreSQL) -------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=stive_clothing
DB_USERNAME=stive
DB_PASSWORD=secret
DB_SCHEMA=public

# --- Sessions / files / queues ---------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Authentification de l'administration (Sanctum) ------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:4200,127.0.0.1,127.0.0.1:4200
SANCTUM_TOKEN_PREFIX=stv_
# Durée de vie des jetons d'administration, en minutes (480 = 8 h)
ADMIN_TOKEN_TTL=480

# --- Boutique Stive Clothing ------------------------------------------------
# Numéro WhatsApp professionnel au format international, sans "+" ni espaces.
STIVE_WHATSAPP_NUMBER=237600000000
STIVE_WHATSAPP_DEFAULT_MESSAGE=Bonjour Stive Clothing, je souhaite des informations sur une pièce.
STIVE_CURRENCY=XAF
STIVE_ORDER_PREFIX=STV
STIVE_ORDERS_PER_MINUTE=5
STIVE_LOGIN_ATTEMPTS_PER_MINUTE=5

# --- Médias ----------------------------------------------------------------
# Disque de stockage des photos produits : "public" en local, "s3" en production.
PRODUCT_MEDIA_DISK=public
PRODUCT_IMAGE_MAX_KB=4096
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@stiveclothing.example"
MAIL_FROM_NAME="${APP_NAME}"
